# Runtime settings: copy only this template; never commit or upload a real .env.
COMPOSE_PROJECT_NAME=altercharge
SPRING_PROFILES_ACTIVE=prod
APP_DOMAIN=needed
APP_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
AWS_REGION=ap-northeast-2

# Restricted application role. A separate bootstrap administrator is required.
POSTGRES_DB=altercharge
POSTGRES_USER=altercharge
POSTGRES_PASSWORD=needed
POSTGRES_ADMIN_PASSWORD=needed
POSTGRES_PORT=5432

DATA_GO_KR_BASE_URL=https://apis.data.go.kr/B552584/EvCharger
DATA_GO_KR_SERVICE_KEY=needed
DATA_GO_KR_DATA_TYPE=XML
DATA_GO_KR_ZCODES=11
DATA_GO_KR_STATUS_REFRESH_SECONDS=300
DATA_GO_KR_INFO_REFRESH_SECONDS=86400
DATA_GO_KR_ENABLED=true
DATA_GO_KR_NUM_OF_ROWS=9999
DATA_GO_KR_DAILY_BUDGET=900
DATA_GO_KR_METADATA_BUDGET=100

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Enable once only to adopt a verified existing pre-Flyway schema, then reset.
FLYWAY_ADOPT_LEGACY_SCHEMA=false
STATION_STATUS_MAX_AGE_MINUTES=15
HISTORY_RETENTION_DAYS=56
HISTORY_MAX_FUTURE_MINUTES=5
