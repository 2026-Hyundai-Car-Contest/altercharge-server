# Copy this file to .env and replace both password placeholders locally.
# POSTGRES_USER is a restricted application role; postgres is reserved for setup.
POSTGRES_DB=altercharge
POSTGRES_USER=altercharge_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_ADMIN_PASSWORD

# Use the decoded or already URL-encoded service key supplied by data.go.kr.
DATA_GO_KR_SERVICE_KEY=YOUR_SERVICE_KEY_HERE
# This initial service only collects the configured regions (11 = Seoul).
DATA_GO_KR_ZCODES=11
DATA_GO_KR_ENABLED=true
# Hard daily budget leaves 100 calls below the assumed 1,000-call limit.
DATA_GO_KR_NUM_OF_ROWS=9999
DATA_GO_KR_DAILY_BUDGET=900
DATA_GO_KR_METADATA_BUDGET=100

HTTPS_PORT=8443
